# yurika.space — environment variable template
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored. Never commit secrets.

# --- Django ---
SECRET_KEY=replace-with-50-char-random-string-for-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,django
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --- Postgres ---
POSTGRES_DB=yurika_space
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Neo4j ---
# Format: user/password (single string). Default password "password" is dev-only.
NEO4J_AUTH=neo4j/password

# --- Frontend ---
# NEXT_PUBLIC_* vars get embedded in the client bundle (visible in browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# INTERNAL_* vars are server-only. Used by Next.js server components inside docker.
INTERNAL_API_BASE_URL=http://django:8000

# --- Web3 (subsystem 7, leave blank for now) ---
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532

# --- Contracts (subsystem 7, leave blank for now) ---
YURIKA_VAULT_CONTRACT_ADDRESS=
NEXT_PUBLIC_SHARD_TOKEN_ADDRESS=

# --- External services (later subsystems) ---
RESEND_API_KEY=
SENTRY_DSN=
DYNAMIC_ENVIRONMENT_ID=

# --- Supabase (waitlist only — optional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

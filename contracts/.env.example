# Required for `forge script --rpc-url base_sepolia ...`
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Required for `forge script ... --broadcast`. Used as msg.sender for
# all deploy txs. Never commit a key with real funds; use a fresh
# wallet funded via the Base Sepolia faucet:
#   https://docs.base.org/docs/tools/network-faucets/
DEPLOYER_PRIVATE_KEY=0x

# Required for `forge verify-contract` (Basescan).
# Get a free key at https://basescan.org/myapikey
BASESCAN_API_KEY=

# Mainnet config (unused for v0.7.0 — testnet only)
BASE_RPC_URL=https://mainnet.base.org

# Constructor args for YurikaVault — defaults to deployer if unset.
GOVERNANCE_ADDRESS=
